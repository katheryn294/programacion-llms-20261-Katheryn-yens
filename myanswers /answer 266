        "print(\"\\n================ DATAFRAME ORIGINAL ================\\n\")\n",
        "print(df)\n",
        "\n",
        "print(\"\\n================ RESUMEN DE VENTAS ================\\n\")\n",
        "print(output_data)"
      ]
