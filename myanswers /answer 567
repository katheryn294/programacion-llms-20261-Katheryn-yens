        "        print(f\"\\n{k}:\\n\")\n",
        "        print(v)\n",
        "\n",
        "    # Mostrar OUTPUTS\n",
        "    print(\"\\n----------- OUTPUT ESPERADO -----------\")\n",
        "\n",
